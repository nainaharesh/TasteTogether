          "name": "Unfollow user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/{{otherUserId}}/follow", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{otherUserId}}", "follow"] }
          }
        }
      ]
    },
    {
      "name": "Restaurants",
      "item": [
        {
          "name": "List restaurants",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.restaurants && body.restaurants.length) {",
                  "    pm.collectionVariables.set('restaurantId', body.restaurants[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants?cuisine=all&sort=popular&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants"],
              "query": [
                { "key": "cuisine", "value": "all" },
                { "key": "sort", "value": "popular" },
                { "key": "lat", "value": "40.73", "disabled": true },
                { "key": "lng", "value": "-73.99", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get restaurant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.popularDishes && body.popularDishes.length) {",
                  "    pm.collectionVariables.set('dishId', body.popularDishes[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/restaurants/{{restaurantId}}", "host": ["{{baseUrl}}"], "path": ["api", "restaurants", "{{restaurantId}}"] }
